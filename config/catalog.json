  "duplicate_exempt_orgs": ["meta-llama"],
  "featured_regions": {"KR": 0.5},
  "general_pct": 0.18,
  "special_pct": 0.3,
  "special_min": 2,
  "category_rules": [
    ["code", "(coder|code|codestral|devstral|starcoder)"],
    ["math", "(math|mathstral)"],
    ["medical", "(medgemma|medical|\\bmed\\b|-med-|bio|clinic|health)"],
